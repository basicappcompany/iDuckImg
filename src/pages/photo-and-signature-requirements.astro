---
import CommunityLayout from '../components/CommunityLayout.astro';
import { EXAMS, describeRequirements, type ExamPreset } from '../lib/exam-presets';
import { examPageSlug, readableDate } from '../lib/exam-landing';
import { SITE_UPDATED, breadcrumbLd } from '../lib/seo';

// Families, in the order shown. An exam not matched here is shown under "Other".
const FAMILIES: { name: string; match: (e: ExamPreset) => boolean }[] = [
  { name: 'SSC (Staff Selection Commission)', match: (e) => e.id.startsWith('ssc-') },
  { name: 'IBPS (banks)', match: (e) => e.id.startsWith('ibps-') },
  { name: 'SBI (State Bank of India)', match: (e) => e.id.startsWith('sbi-') },
  { name: 'NTA entrance exams (NEET, JEE Main, CUET)', match: (e) => /^(neet|jee|cuet)-/.test(e.id) },
  { name: 'CTET and GATE', match: (e) => /^(ctet|gate)-/.test(e.id) },
  { name: 'Passport photos (digital)', match: (e) => /passport/.test(e.id) },
];
const used = new Set<string>();
const families = FAMILIES.map((f) => {
  const exams = EXAMS.filter((e) => f.match(e) && !used.has(e.id));
  exams.forEach((e) => used.add(e.id));
  return { name: f.name, exams };
}).filter((f) => f.exams.length > 0);
const other = EXAMS.filter((e) => !used.has(e.id));
if (other.length > 0) families.push({ name: 'Other', exams: other });
const docCount = EXAMS.reduce((n, e) => n + e.documents.length, 0);

const jsonLd = [
  breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'Photo and signature requirements', path: '/photo-and-signature-requirements/' },
  ]),
];
---

<CommunityLayout
  title="Photo and signature requirements for exam forms | iDuckIMG"
  description="Photo, signature and thumb impression sizes for IBPS, SBI, SSC, NEET, JEE Main, CUET, CTET and GATE, each with its official source and the date we read it."
  before="Photo and signature"
  mark="requirements"
  intro={`Pixels and file sizes for ${docCount} documents across ${EXAMS.length} exams and photo pages, copied from official notices. Each row links to the source and says when we read it.`}
  jsonLd={jsonLd}
>
  <section class="card p-5" aria-labelledby="how">
    <h2 id="how" class="text-2xl font-black tracking-tight">How to read this page</h2>
    <p class="mt-2 leading-relaxed">
      Every number below was read from an official document and is shown with the document, the place in it and the date we
      read it. Where a document gives only a file size or only centimetres, this page says so and shows no pixel size. We
      never take a requirement from another website. Rules change with each exam cycle, so check your own notice. Last
      reviewed {SITE_UPDATED}.
    </p>
    <p class="mt-3 leading-relaxed">
      To get a file to the exact size, open the page for your exam. It is already set up and runs in your browser, so nothing is
      uploaded.
    </p>
  </section>

  {
    families.map((family) => (
      <section class="card p-5" aria-label={family.name}>
        <h2 class="text-2xl font-black tracking-tight">{family.name}</h2>
        {family.exams.map((exam) => (
          <div class="mt-5">
            <h3 class="text-lg font-black">{exam.name}</h3>
            <p class="mt-1 text-sm text-muted">{exam.cycle}</p>
            <div class="mt-2 overflow-x-auto">
              <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
                <thead>
                  <tr class="border-b-2 border-line">
                    <th class="py-2 pr-3">Document</th>
                    <th class="py-2 pr-3">What the document asks for</th>
                    <th class="py-2 pr-3">Size in centimetres, if given</th>
                    <th class="py-2">Make it</th>
                  </tr>
                </thead>
                <tbody>
                  {exam.documents.map((doc) => (
                    <tr class="border-b border-line align-top">
                      <td class="py-2 pr-3 font-bold">{doc.name}</td>
                      <td class="py-2 pr-3">{describeRequirements(doc)}</td>
                      <td class="py-2 pr-3">{doc.physical ?? 'not given'}</td>
                      <td class="py-2"><a class="link" href={`/${examPageSlug(exam, doc)}/`}>Open the tool</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="mt-2 text-sm">
              Source: <a class="link" href={exam.source.url} rel="noopener">{exam.source.title}</a>, {exam.source.location}. Read on{' '}
              {readableDate(exam.source.retrieved)}.
            </p>
          </div>
        ))}
      </section>
    ))
  }

  <section class="card p-5" aria-labelledby="missing">
    <h2 id="missing" class="text-2xl font-black tracking-tight">What is not here, and why</h2>
    <p class="mt-2 leading-relaxed">
      We publish a page only when we could read the official document. We could not read the official numbers for UPSC (the
      notice sends you to a separate instruction page we could not open), the Railway Recruitment Boards, CAT, PAN, the Indian
      passport, Aadhaar, the driving licence, or the US, UK, Canada and Schengen visas, so they are not listed. For any exam
      that is not here, open the <a class="link" href="/exam-photo-resizer/">Exam photo and signature resizer</a>, choose Other
      exam and type the sizes from your own notice.
    </p>
  </section>
</CommunityLayout>
