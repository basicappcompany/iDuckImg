---
import ToolLayout from '../components/ToolLayout.astro';
import ToolGuide from '../components/ToolGuide.astro';
import BorderTool from '../tools/border/BorderTool';

const steps = [
  'Drop your JPG, PNG or WebP pictures, or paste them.',
  'Set how thick the border is and choose a colour: white, black, yellow, see-through, or type your own colour code.',
  'Check the preview, then press Add border.',
  'Download each file, or all of them as a ZIP.',
];
const notes = [
  'The border is added around the picture, so the result is a little bigger than the original and nothing is cut off. The thickness is a share of the shorter side, so it looks the same on a small photo and on a large one.',
  'A see-through border needs a format that supports transparency, so a JPG becomes a PNG when you choose it. Other pictures keep their own format.',
];
const faqs = [
  {
    q: 'How do I add a white border to a photo?',
    a: 'Drop the photo, leave the colour on White, set the thickness and press Add border.',
  },
  {
    q: 'Does the border cover part of my picture?',
    a: 'No. It is added around the outside, so the picture keeps its full size and the result is larger.',
  },
  {
    q: 'Can I use my own colour?',
    a: 'Yes. Type a colour code such as #1e90ff in the colour code box.',
  },
  {
    q: 'Can the border be see-through?',
    a: 'Yes, choose Transparent. The result is saved as a PNG, because JPG cannot be see-through.',
  },
  {
    q: 'Is my picture uploaded?',
    a: 'No. The border is drawn in your browser, so your pictures stay on your device.',
  },
];
---

<ToolLayout
  title="Add a border or frame to a picture online free | iDuckImg"
  description="Add a white, black or coloured border around any JPG, PNG or WebP picture. Choose the thickness and colour with a live preview. Free, in your browser, no upload."
  heading="Add a border or frame"
  steps={steps}
  faqs={faqs}
>
  <BorderTool client:load />
  <div slot="content">
    <ToolGuide title="How to add a border to a picture" steps={steps} notes={notes} faqs={faqs} />
  </div>
</ToolLayout>
