---
import ToolLayout from '../components/ToolLayout.astro';
import ExifTool from '../tools/exif/ExifTool';
---

<ToolLayout
  title="Remove EXIF data from photos online free | iDuckImg"
  description="Remove location, camera and date data from JPG, PNG and WebP photos before you share them. Free, in your browser, no upload. Quality is not changed."
  heading="Remove EXIF data from photos"
>
  <ExifTool client:load />
  <section slot="content" class="prose mt-10">
    <h2 class="text-xl font-semibold">Why remove EXIF data</h2>
    <p class="mt-2 text-sm">
      Photos from phones and cameras often carry hidden details: the exact GPS location where it was taken,
      the date and time, and the device model. Removing them before you post or send a picture protects your
      privacy.
    </p>
    <h2 class="mt-6 text-xl font-semibold">How to remove it</h2>
    <ol class="mt-2 list-decimal pl-6">
      <li>Drop your JPG, PNG or WebP photos, or paste them.</li>
      <li>Press Remove metadata.</li>
      <li>Download each cleaned file, or all of them as a ZIP.</li>
    </ol>
    <p class="mt-3 text-sm">
      Your photos are processed in your browser and never uploaded. The picture itself is not recompressed.
    </p>
  </section>
</ToolLayout>
