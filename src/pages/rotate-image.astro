---
import ToolLayout from '../components/ToolLayout.astro';
import RotateTool from '../tools/rotate/RotateTool';
---

<ToolLayout
  title="Rotate and flip images online free | iDuckImg"
  description="Rotate images 90, 180 or 270 degrees and flip them horizontally or vertically. Free, in your browser, no upload. Works with JPG, PNG and WebP."
  heading="Rotate and flip images"
>
  <RotateTool client:load />
  <section slot="content" class="prose">
    <h2>How to rotate or flip an image</h2>
    <ol>
      <li>Drop your JPG, PNG or WebP files, or paste them.</li>
      <li>Use the buttons to rotate left or right, or to flip. The preview shows the result.</li>
      <li>Press Apply and download each file, or all of them as a ZIP.</li>
    </ol>
    <p class="mt-3 text-sm">
      The same change is applied to every image you add. PNG stays lossless. JPG and WebP are saved again
      at high quality.
    </p>
  </section>
</ToolLayout>
