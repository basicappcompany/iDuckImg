---
import ToolLayout from '../components/ToolLayout.astro';
import LogoTool from '../tools/logo/LogoTool';

const steps = [
  'Drop your JPG, PNG or WebP pictures, or paste them.',
  'Choose your logo. A PNG with a transparent background looks best.',
  'Choose where it goes, how big and how see-through it is, or repeat it across the picture. The preview updates as you change them.',
  'Press Add logo and download each file, or all of them as a ZIP.',
];
const faqs = [
  {
    q: 'Can I put my logo on many pictures at once?',
    a: 'Yes. Add as many pictures as you like. The same logo is placed on every one, at the same relative size, and you can download them together as a ZIP.',
  },
  {
    q: 'Which logo files work?',
    a: 'PNG, JPG and WebP. A PNG or WebP with a transparent background looks best, because a JPG logo keeps its white box. SVG logos are not supported yet; export yours as a PNG first.',
  },
  {
    q: 'Are my pictures or my logo uploaded?',
    a: 'No. The logo is drawn onto the picture in your browser, so both files stay on your device.',
  },
  {
    q: 'Can someone remove a logo watermark?',
    a: 'A visible logo discourages copying, but a determined person can crop or edit it out. Put it near the middle or repeat it across the picture to make that harder.',
  },
  {
    q: 'Does it work on a phone?',
    a: 'Yes. Choose pictures and your logo from your gallery and download the results.',
  },
];
---

<ToolLayout
  title="Add a logo to images online free | iDuckIMG"
  description="Put your logo on JPG, PNG and WebP pictures. Choose position, size and opacity, or repeat it across the picture. Free, in your browser, no upload."
  heading="Add a logo to pictures"
  steps={steps}
  faqs={faqs}
>
  <LogoTool client:load />
  <section slot="content" class="prose">
    <h2>How to add a logo to a picture</h2>
    <ol>
      {steps.map((step) => <li>{step}</li>)}
    </ol>
    <p class="mt-3 text-sm">
      The logo keeps its own proportions, and its size is a share of the picture width, so it looks the same on a small
      photo and on a large one. Pictures are saved in their own format. JPG and WebP are saved again at high quality,
      and PNG stays lossless. Want text instead? Use <a href="/add-watermark-to-image/">Add a watermark</a>.
    </p>
    <h2 class="mt-8">Common questions</h2>
    <div class="mt-4 grid gap-3">
      {
        faqs.map((f) => (
          <details class="card px-4 py-3">
            <summary class="cursor-pointer text-lg font-black">{f.q}</summary>
            <p class="mt-2 leading-relaxed">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</ToolLayout>
