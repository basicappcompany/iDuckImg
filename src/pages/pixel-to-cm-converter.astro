---
import ToolLayout from '../components/ToolLayout.astro';
import ToolGuide from '../components/ToolGuide.astro';
import LengthConverter from '../calculators/LengthConverter';

const steps = [
  'Type the length you have and choose its unit: pixels, centimeters, millimeters or inches.',
  'Choose the resolution in DPI (dots per inch). Use 300 for print photos, 72 or 96 for screens, or type your own.',
  'Read the same length in every unit below.',
];
const notes = [
  'Pixels have no physical size on their own. How big a picture is on paper depends on the DPI: the same 1200 pixels are 4 inches wide at 300 DPI and 16.7 inches wide at 72 DPI. That is why the DPI matters for this conversion.',
  'The table of common sizes shows how many pixels A4, Letter, passport photos and 4 x 6 in prints need at the DPI you chose. Changing the DPI of a file does not change its pixels; use Resize images for that.',
];
const faqs = [
  {
    q: 'How many pixels is 1 cm?',
    a: 'At 300 DPI, 1 cm is about 118 pixels. At 96 DPI it is about 38 pixels. The formula is pixels = cm / 2.54 x DPI.',
  },
  {
    q: 'How many pixels is A4 paper?',
    a: 'At 300 DPI, A4 (210 x 297 mm) is 2480 x 3508 pixels. At 150 DPI it is 1240 x 1754 pixels.',
  },
  {
    q: 'What DPI should I use?',
    a: 'Use 300 DPI for printing photos, 150 for casual prints and drafts, and 72 or 96 for screens. Choose Other to type a different value.',
  },
  {
    q: 'How do I convert pixels to inches?',
    a: 'Divide the pixels by the DPI. 1800 pixels at 300 DPI is 6 inches.',
  },
  {
    q: 'Does this change my picture?',
    a: 'No. It is a calculator and does not use any file. To change the real pixel size of a picture, use Resize images.',
  },
];
---

<ToolLayout
  title="Pixel to cm, mm and inch converter with DPI | iDuckIMG"
  description="Convert pixels to centimeters, millimeters and inches at any DPI, and see A4, Letter and passport photo sizes in pixels. Free, instant, no sign-up."
  heading="Pixel, cm and inch converter"
  steps={steps}
  faqs={faqs}
  usesFiles={false}
>
  <LengthConverter client:load />
  <div slot="content">
    <ToolGuide title="How to convert pixels to cm or inches" steps={steps} notes={notes} />
  </div>
</ToolLayout>
