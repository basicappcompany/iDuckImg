---
/**
 * A tool page in another language: /es/compress-image/ and so on. The heading, summary, quick answer and
 * page chrome are translated; the tool itself is the same island as on the English page, so its controls
 * are English for now and the page says so. One page per tool per language, built from src/i18n.
 */
import ToolLayout from '../../components/ToolLayout.astro';
import AdjustTool from '../../tools/adjust/AdjustTool';
import Base64Tool from '../../tools/base64/Base64Tool';
import BlurTool from '../../tools/blur/BlurTool';
import BorderTool from '../../tools/border/BorderTool';
import CompressTool from '../../tools/compress/CompressTool';
import ConvertTool from '../../tools/convert/ConvertTool';
import CropTool from '../../tools/crop/CropTool';
import ExamTool from '../../tools/exam/ExamTool';
import ExifTool from '../../tools/exif/ExifTool';
import FaviconTool from '../../tools/favicon/FaviconTool';
import GridTool from '../../tools/grid/GridTool';
import ImagesToPdfTool from '../../tools/pdf/ImagesToPdfTool';
import LogoTool from '../../tools/logo/LogoTool';
import MergeTool from '../../tools/merge/MergeTool';
import PaletteTool from '../../tools/colour/PaletteTool';
import ColourPicker from '../../tools/colour/ColourPicker';
import PixelTool from '../../tools/pixel/PixelTool';
import ResizeTool from '../../tools/resize/ResizeTool';
import RotateTool from '../../tools/rotate/RotateTool';
import ShapeTool from '../../tools/shape/ShapeTool';
import TextTool from '../../tools/text/TextTool';
import WatermarkTool from '../../tools/watermark/WatermarkTool';
import LengthConverter from '../../calculators/LengthConverter';
import RatioCalculator from '../../calculators/RatioCalculator';
import { LANDING_PAGES, landingParent, landingPath } from '../../lib/landing';
import { TOOLS, toolPath } from '../../lib/tools';
import { localizedLanding, shortcutText } from '../../i18n/shortcuts';
import { OTHER_LOCALES, dictFor, localeByPath, localePath, toolText } from '../../i18n';


export function getStaticPaths() {
  return OTHER_LOCALES.flatMap((locale) => [...TOOLS, ...LANDING_PAGES].map((item) => ({ params: { lang: locale.path, tool: item.slug } })));
}

// Astro needs every hydrated component imported by name, so each tool is listed out below rather than looked up.
const { lang, tool: slug } = Astro.params as { lang: string; tool: string };
const locale = localeByPath(lang)!;
const d = dictFor(locale.code);
const page = LANDING_PAGES.find((p) => p.slug === slug);
const text = toolText(locale.code, slug);
const local = page ? localizedLanding(page, locale.code) : undefined;
const sc = shortcutText(locale.code);
const relatedLinks = (page?.related ?? []).flatMap((rel) => {
  const tool = TOOLS.find((t) => t.slug === rel);
  if (tool) return [{ href: localePath(locale.code, toolPath(tool.slug)), label: toolText(locale.code, tool.slug).name, emoji: tool.emoji }];
  const other = LANDING_PAGES.find((p) => p.slug === rel);
  if (other) return [{ href: localePath(locale.code, landingPath(other.slug)), label: localizedLanding(other, locale.code).name, emoji: other.emoji }];
  return [];
});
---

{
  page && local ? (
    <ToolLayout
      locale={locale.code}
      title={`${local.title} | iDuckIMG`}
      description={local.description}
      heading={local.h1}
      landing={{ emoji: page.emoji, summary: local.summary, quick: local.quick, parentSlug: landingParent(page).slug }}
      steps={local.steps}
      faqs={local.faqs}
    >
      {page.engine === 'compress' && <CompressTool client:load initial={page.initial} />}
      {page.engine === 'resize' && <ResizeTool client:load initial={page.initial} />}
      {page.engine === 'convert' && <ConvertTool client:load initial={page.initial} />}
      {page.engine === 'exam' && <ExamTool client:load initialExam={String(page.initial['examId'])} initialDoc={String(page.initial['docId'])} />}

      <div slot="content" class="grid gap-8">
        <section class="prose" aria-label={sc.chrome.howToUse}>
          <h2>{sc.chrome.howToUse}</h2>
          <ol>
            {local.steps.map((step) => <li>{step}</li>)}
          </ol>
        </section>

        <section aria-label={d.faqHeading}>
          <h2 class="text-3xl font-black tracking-tight">{d.faqHeading}</h2>
          <div class="mt-4 grid gap-3">
            {
              local.faqs.map((f) => (
                <details class="card px-4 py-3">
                  <summary class="cursor-pointer text-lg font-black">{f.q}</summary>
                  <p class="mt-2 leading-relaxed">{f.a}</p>
                </details>
              ))
            }
          </div>
        </section>

        <nav aria-label={sc.chrome.related}>
          <h2 class="text-2xl font-black tracking-tight">{sc.chrome.related}</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              relatedLinks.map((l) => (
                <li>
                  <a href={l.href} class="btn btn-sm">
                    <span aria-hidden="true">{l.emoji}</span>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </ToolLayout>
  ) : (
<ToolLayout locale={locale.code} title={`${text.name} | iDuckIMG`} description={`${text.summary} ${d.toolDescSuffix}`} heading={text.name}>
  {slug === 'compress-image' && <CompressTool client:load />}
  {slug === 'resize-image' && <ResizeTool client:load />}
  {slug === 'crop-image' && <CropTool client:load />}
  {slug === 'add-watermark-to-image' && <WatermarkTool client:load />}
  {slug === 'add-logo-to-image' && <LogoTool client:load />}
  {slug === 'exam-photo-resizer' && <ExamTool client:load />}
  {slug === 'convert-image' && <ConvertTool client:load />}
  {slug === 'image-to-pdf' && <ImagesToPdfTool client:load />}
  {slug === 'rotate-image' && <RotateTool client:load />}
  {slug === 'remove-exif-data' && <ExifTool client:load />}
  {slug === 'circle-crop-image' && <ShapeTool client:load />}
  {slug === 'split-image-into-grid' && <GridTool client:load />}
  {slug === 'add-text-to-image' && <TextTool client:load />}
  {slug === 'pixel-art-maker' && <PixelTool client:load />}
  {slug === 'merge-images' && <MergeTool client:load />}
  {slug === 'blur-image' && <BlurTool client:load />}
  {slug === 'pixel-to-cm-converter' && <LengthConverter client:load />}
  {slug === 'aspect-ratio-calculator' && <RatioCalculator client:load />}
  {slug === 'adjust-image-colors' && <AdjustTool client:load />}
  {slug === 'add-border-to-image' && <BorderTool client:load />}
  {slug === 'color-picker-from-image' && <ColourPicker client:load />}
  {slug === 'color-palette-generator' && <PaletteTool client:load />}
  {slug === 'image-to-base64' && <Base64Tool client:load />}
  {slug === 'favicon-generator' && <FaviconTool client:load />}
</ToolLayout>
  )
}
