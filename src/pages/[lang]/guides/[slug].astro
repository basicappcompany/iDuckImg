---
/**
 * A how-to guide in another language: /es/guides/how-to-compress-an-image/ and so on. The text comes from
 * src/i18n/guides (English (UK) is the English guide in British spelling); the tool, the related guides and the
 * date it was last checked are the English guide's own.
 */
import AppShell from '../../../components/AppShell.astro';
import { GUIDES, guideForSlug, guidePath, type Guide } from '../../../lib/guides';
import { TOOLS, toolPath } from '../../../lib/tools';
import { articleLd, breadcrumbLd, faqLd, howToLd } from '../../../lib/seo';
import { OTHER_LOCALES, alternatesFor, format, localeByPath, localePath, toolText } from '../../../i18n';
import { guideChromeFor, guideTextFor } from '../../../i18n/guides';

export function getStaticPaths() {
  return OTHER_LOCALES.flatMap((locale) => GUIDES.map((guide) => ({ params: { lang: locale.path, slug: guide.slug }, props: { guide } })));
}

const { lang } = Astro.params as { lang: string };
const { guide } = Astro.props as { guide: Guide };
const locale = localeByPath(lang)!;
const c = guideChromeFor(locale.code);
const g = guideTextFor(locale.code, guide);
const lp = (p: string) => localePath(locale.code, p);
const tool = TOOLS.find((t) => t.slug === guide.tool)!;
const related = guide.related.map((s) => guideForSlug(s)).filter((x): x is Guide => Boolean(x));
const path = lp(guidePath(guide.slug));
const checked = new Intl.DateTimeFormat(locale.hreflang, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${guide.updated}T00:00:00Z`));

const jsonLd = [
  articleLd({ headline: g.title, description: g.description, path, datePublished: guide.updated, dateModified: guide.updated, lang: locale.hreflang }),
  howToLd(g.title, g.steps),
  faqLd(g.faq),
  breadcrumbLd([
    { name: c.home, path: lp('/') },
    { name: c.guides, path: lp('/guides/') },
    { name: g.title, path },
  ]),
];
---

<AppShell locale={locale.code} alternates={alternatesFor(guidePath(guide.slug))} title={`${g.seoTitle} | iDuckImg`} description={g.description} jsonLd={jsonLd}>
  <article>
    <p class="eyebrow">
      <a href={lp('/')} class="underline decoration-2 underline-offset-2">{c.home}</a>
      <span aria-hidden="true"> / </span>
      <a href={lp('/guides/')} class="underline decoration-2 underline-offset-2">{c.guides}</a>
    </p>
    <h1 class="display mt-2 text-3xl sm:text-4xl">{g.title}</h1>

    <section aria-label={c.quickAnswer} class="card mt-5 p-4">
      <p class="eyebrow">{c.quickAnswer}</p>
      <p class="mt-1 text-lg leading-relaxed">{g.intro}</p>
    </section>

    <p class="mt-5">
      <a href={lp(toolPath(tool.slug))} class="btn btn-primary btn-lg">
        <span aria-hidden="true">{tool.emoji}</span> {format(c.openTool, { tool: toolText(locale.code, tool.slug).name })}
      </a>
    </p>

    <div class="prose mt-8">
      <h2>{c.steps}</h2>
      <ol>
        {g.steps.map((step) => <li>{step}</li>)}
      </ol>
      {
        g.sections.map((s) => (
          <>
            <h2 class="mt-8">{s.h}</h2>
            {s.p.map((text) => <p class="mt-3">{text}</p>)}
          </>
        ))
      }
    </div>

    <section aria-label={c.commonQuestions} class="mt-10">
      <h2 class="text-3xl font-black tracking-tight">{c.commonQuestions}</h2>
      <div class="mt-4 grid gap-3">
        {
          g.faq.map((f) => (
            <details class="card px-4 py-3">
              <summary class="cursor-pointer text-lg font-black">{f.q}</summary>
              <p class="mt-2 leading-relaxed">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <p class="mt-8 text-sm text-muted">{format(c.writtenBy, { date: checked })}</p>
  </article>

  {
    related.length > 0 && (
      <nav class="mt-10" aria-label={c.relatedGuides}>
        <h2 class="text-2xl font-black tracking-tight">{c.relatedGuides}</h2>
        <ul class="card-grid mt-3">
          {related.map((r) => (
            <li>
              <a href={lp(guidePath(r.slug))} class="card card-link h-full p-4">
                <span class="block text-[17px] font-black">{guideTextFor(locale.code, r).title}</span>
                <span class="mt-1 block text-sm leading-[19px] text-muted">{guideTextFor(locale.code, r).description}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <p class="mt-8">
    <a class="link" href={lp('/guides/')}>{c.allGuides}</a>
  </p>
</AppShell>
