---
import CommunityLayout from '../components/CommunityLayout.astro';
import FeedbackForm from '../components/FeedbackForm';
---

<CommunityLayout
  title="Request a feature | iDuckImg"
  description="Tell us about an image tool or improvement you would like to see on iDuckImg."
  before="Got an"
  mark="idea"
  after="?"
  intro="Describe a new tool, or a way an existing one could work better, with a real example if you can. Everything we have announced is already built, so your ideas shape what comes next."
  noindex
>
  <FeedbackForm mode="request" client:load />
  <p class="text-sm text-muted">
    You can also look at the <a class="link" href="/roadmap/">roadmap</a> to see what is already on our list.
  </p>
</CommunityLayout>
