---
import AppShell from '../../components/AppShell.astro';
import { GUIDES, guideForSlug, guidePath, type Guide } from '../../lib/guides';
import { TOOLS, toolPath } from '../../lib/tools';
import { articleLd, breadcrumbLd, faqLd, howToLd } from '../../lib/seo';
import { alternatesFor } from '../../i18n';

export function getStaticPaths() {
  return GUIDES.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const tool = TOOLS.find((t) => t.slug === guide.tool)!;
const related = guide.related.map((s) => guideForSlug(s)).filter((g): g is Guide => Boolean(g));
const path = guidePath(guide.slug);
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const [y, m, d] = guide.updated.split('-').map(Number);
const checked = `${d} ${MONTHS[(m ?? 1) - 1]} ${y}`;

const jsonLd = [
  articleLd({ headline: guide.title, description: guide.description, path, datePublished: guide.updated, dateModified: guide.updated }),
  howToLd(guide.title, guide.steps),
  faqLd(guide.faq),
  breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'How-to guides', path: '/guides/' },
    { name: guide.title, path },
  ]),
];
---

<AppShell alternates={alternatesFor(guidePath(guide.slug))} title={`${guide.seoTitle} | iDuckIMG`} description={guide.description} jsonLd={jsonLd}>
  <article>
    <p class="eyebrow">
      <a href="/" class="underline decoration-2 underline-offset-2">Home</a>
      <span aria-hidden="true"> / </span>
      <a href="/guides/" class="underline decoration-2 underline-offset-2">How-to guides</a>
    </p>
    <h1 class="display mt-2 text-3xl sm:text-4xl">{guide.title}</h1>

    <section aria-label="Quick answer" class="card mt-5 p-4">
      <p class="eyebrow">Quick answer</p>
      <p class="mt-1 text-lg leading-relaxed">{guide.intro}</p>
    </section>

    <p class="mt-5">
      <a href={toolPath(tool.slug)} class="btn btn-primary btn-lg">
        <span aria-hidden="true">{tool.emoji}</span> Open {tool.name}
      </a>
    </p>

    <div class="prose mt-8">
      <h2>Steps</h2>
      <ol>
        {guide.steps.map((step) => <li>{step}</li>)}
      </ol>
      {
        guide.sections.map((s) => (
          <>
            <h2 class="mt-8">{s.h}</h2>
            {s.p.map((text) => <p class="mt-3">{text}</p>)}
          </>
        ))
      }
    </div>

    <section aria-label="Common questions" class="mt-10">
      <h2 class="text-3xl font-black tracking-tight">Common questions</h2>
      <div class="mt-4 grid gap-3">
        {
          guide.faq.map((f) => (
            <details class="card px-4 py-3">
              <summary class="cursor-pointer text-lg font-black">{f.q}</summary>
              <p class="mt-2 leading-relaxed">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <p class="mt-8 text-sm text-muted">
      Written by Basic App Company. Last checked against the tool on {checked}. The tool runs in your browser, so your pictures are not uploaded.
    </p>
  </article>

  {
    related.length > 0 && (
      <nav class="mt-10" aria-label="Related guides">
        <h2 class="text-2xl font-black tracking-tight">Related guides</h2>
        <ul class="card-grid mt-3">
          {related.map((g) => (
            <li>
              <a href={guidePath(g.slug)} class="card card-link h-full p-4">
                <span class="block text-[17px] font-black">{g.title}</span>
                <span class="mt-1 block text-sm leading-[19px] text-muted">{g.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <p class="mt-8">
    <a class="link" href="/guides/">All how-to guides</a>
  </p>
</AppShell>
