---
import ToolLayout from '../components/ToolLayout.astro';
import ImagesToPdfTool from '../tools/pdf/ImagesToPdfTool';
---

<ToolLayout
  title="Combine images into one PDF online free | iDuckImg"
  description="Turn several JPG, PNG or WebP images into a single PDF. Reorder the pages, choose A4 or image size. Free, in your browser, no upload."
  heading="Combine images into one PDF"
>
  <ImagesToPdfTool client:load />
  <section slot="content" class="prose mt-10">
    <h2 class="text-xl font-semibold">How to make a PDF from images</h2>
    <ol class="mt-2 list-decimal pl-6">
      <li>Drop your JPG, PNG or WebP images. You can add more at any time.</li>
      <li>Put them in the order you want with Up and Down. Remove any you do not need.</li>
      <li>Choose A4 with margins, or pages that match each image, then press Create PDF.</li>
    </ol>
    <p class="mt-3 text-sm">
      Each image becomes one page. Your images are combined in your browser and never uploaded. Need a
      separate PDF for every image instead? Use the
      <a class="text-pond-600 underline" href="/convert-image/">image converter</a>.
    </p>
  </section>
</ToolLayout>
