---
import ToolLayout from '../components/ToolLayout.astro';
import ToolGuide from '../components/ToolGuide.astro';
import CropTool from '../tools/crop/CropTool';

const steps = [
  "Drop your JPG, PNG or WebP image, or paste it.",
  "Drag the box and its handles over the part you want. Pick a shape such as 1:1 or 16:9 if you need one.",
  "Press Crop.",
  "Download the result."
];
const notes = [
  "You can also type the exact left, top, width and height in pixels, and move the box with the arrow keys. The cropped picture keeps its original format. Your image is cropped in your browser and never uploaded."
];
const faqs = [
  {
    "q": "How do I crop a photo to a square?",
    "a": "Choose the 1:1 shape, move the box over the part you want, and press Crop."
  },
  {
    "q": "Can I crop to exact pixels?",
    "a": "Yes. Type the left, top, width and height in pixels. The result has exactly that size."
  },
  {
    "q": "Can I crop without a mouse?",
    "a": "Yes. The box can be moved with the arrow keys, and every value can be typed, so it works with a keyboard or a touch screen."
  },
  {
    "q": "Does the picture change format?",
    "a": "No. A JPG stays a JPG, a PNG stays a PNG and a WebP stays a WebP."
  },
  {
    "q": "Is my picture uploaded?",
    "a": "No. It is cropped in your browser and stays on your device."
  }
];
---

<ToolLayout
  title="Crop images online free: drag, ratios or exact pixels | iDuckIMG"
  description="Crop JPG, PNG and WebP images by dragging a box, picking a ratio such as 1:1 or 16:9, or typing exact pixels. Free, in your browser, no upload."
  heading="Crop images"
  steps={steps}
  faqs={faqs}
>
  <CropTool client:load />
  <div slot="content">
    <ToolGuide title="How to crop an image" steps={steps} notes={notes} faqs={faqs} />
  </div>
</ToolLayout>
