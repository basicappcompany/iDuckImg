---
import AppShell from '../components/AppShell.astro';
import DuckMark from '../components/DuckMark.astro';
import { TOOLS, TOOL_GROUPS, toolPath, toolsInGroup } from '../lib/tools';
import { popularTools } from '../lib/quick';
import { GUIDES, guidePath } from '../lib/guides';
import { alternatesFor } from '../i18n';
import { LANDING_PAGES, landingName, landingPath, landingsInGroup } from '../lib/landing';
import { faqLd, organizationLd, websiteLd } from '../lib/seo';

const faqs = [
  {
    q: 'What is iDuckImg?',
    a: 'A free set of image tools: compress, resize, crop, convert, rotate and flip, combine images into one PDF, remove EXIF data, and prepare photos and signatures for exam forms.',
  },
  {
    q: 'Is iDuckImg free?',
    a: 'Yes. There is no sign-up and no watermark on your results. We may show ads to cover the running costs.',
  },
  {
    q: 'Are my images uploaded to a server?',
    a: 'No. Every tool runs in your browser, so your pictures stay on your device and are not sent to us.',
  },
  {
    q: 'Which image formats work?',
    a: 'JPG, PNG and WebP work in every tool. The converter and the PDF tools also open HEIC photos from an iPhone.',
  },
  {
    q: 'Do I need to install anything?',
    a: 'No. Open a tool in any modern browser, on a computer or a phone.',
  },
];

const why = [
  { emoji: '🔒', title: 'Your files stay with you', text: 'Every tool runs in your browser. Your pictures are not uploaded to our servers.' },
  { emoji: '🎁', title: 'No account, no watermark', text: 'Open a tool and use it. Nothing to install, and nothing stamped on your results.' },
  { emoji: '📱', title: 'Made for phones too', text: 'Pick a photo from your gallery or take one, and every tool works at phone size.' },
];
---

<AppShell
  alternates={alternatesFor('/')}
  jsonLd={[websiteLd(), organizationLd(), faqLd(faqs)]}
  title="iDuckImg: free online image tools"
  description="Compress, resize, crop, convert and clean images free in your browser. No upload, no signup. Your files never leave your device."
>
  <section class="text-center">
    <DuckMark size={96} class="mx-auto" />
    <h1 class="display mt-4 text-4xl min-[420px]:text-5xl sm:text-6xl">Images, <span class="mark">sorted</span>.</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-muted">
      {TOOLS.length + LANDING_PAGES.length} free tools to shrink, resize, crop, convert and clean your images. No sign-up, no
      watermark, and everything runs in your browser tab.
    </p>
    <div class="mt-4 flex flex-wrap justify-center gap-2">
      <span class="pill pill-ok">Runs in your browser</span>
      <span class="pill">No sign-up</span>
      <span class="pill">No watermark</span>
    </div>

    <div class="mx-auto mt-6 max-w-xl">
      <button
        type="button"
        id="hero-search"
        class="hero-search"
        aria-label="Search tools, pages and actions"
        data-open-palette
      >
        <span aria-hidden="true" class="text-lg">🔍</span>
        <span class="min-w-0 flex-1 truncate text-left">Search image tools…</span>
        <kbd aria-hidden="true">Ctrl K</kbd>
      </button>
      <p class="mt-2 text-sm text-muted" data-kbd-hint>Press <b>Ctrl K</b> (or <b>/</b>) on any page to search.</p>
    </div>
  </section>

  <section class="mt-8" aria-label="Ask the helper">
    <div class="card flex flex-wrap items-center gap-4 bg-duck p-5 text-duckink">
      <span aria-hidden="true" class="text-4xl">💬</span>
      <div class="min-w-48 flex-1">
        <h2 class="text-xl font-black tracking-tight">Not sure which tool you need?</h2>
        <p class="opacity-80">Describe the job in plain words and the helper will point you to the right one.</p>
      </div>
      <a href="/chat/" class="btn btn-ink">Ask the helper</a>
    </div>
  </section>

  <section class="mt-10" aria-label="Popular right now">
    <h2 class="text-2xl font-black tracking-tight">Popular right now</h2>
    <ul class="card-grid mt-3">
      {
        popularTools().map((p) => (
          <li>
            <a href={p.href} class="card card-link h-full p-4">
              <span class="flex items-center gap-2.5 text-[17px] font-black">
                <span aria-hidden="true" class="text-[28px] leading-none">{p.emoji}</span>
                {p.name}
              </span>
              <span class="mt-1 block text-sm leading-[19px] text-muted">{p.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12" aria-label="Tools">
    <h2 class="text-2xl font-black tracking-tight">All {TOOLS.length + LANDING_PAGES.length} tools</h2>
    <p class="mt-1 text-muted">Pick a group to narrow the list, or press Ctrl K to search.</p>
    <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filter by group">
      <button type="button" class="chip" role="switch" aria-checked="true" data-filter="all">
        Everything ({TOOLS.length + LANDING_PAGES.length})
      </button>
      {
        TOOL_GROUPS.map((group) => (
          <button type="button" class="chip" role="switch" aria-checked="false" data-filter={group}>
            {group} ({toolsInGroup(group).length + landingsInGroup(group).length})
          </button>
        ))
      }
    </div>
    <div class="mt-6">
    {
      TOOL_GROUPS.map((group) => (
        <div class="mt-8 first:mt-0" data-card-group data-group={group}>
          <h3 class="text-2xl font-black tracking-tight">{group}</h3>
          <ul class="card-grid mt-3">
            {toolsInGroup(group).map((tool) => (
              <li data-card data-slug={tool.slug}>
                <a href={toolPath(tool.slug)} class="card card-link h-full p-4">
                  <span class="flex items-center gap-2.5 text-[17px] font-black">
                    <span aria-hidden="true" class="text-[28px] leading-none">
                      {tool.emoji}
                    </span>
                    {tool.name}
                  </span>
                  <span class="mt-1 block text-sm leading-[19px] text-muted">{tool.summary}</span>
                </a>
              </li>
            ))}
            {landingsInGroup(group).map((page) => (
              <li data-card data-slug={page.slug}>
                <a href={landingPath(page.slug)} class="card card-link h-full p-4">
                  <span class="flex items-center gap-2.5 text-[17px] font-black">
                    <span aria-hidden="true" class="text-[28px] leading-none">
                      {page.emoji}
                    </span>
                    {landingName(page)}
                  </span>
                  <span class="mt-1 block text-sm leading-[19px] text-muted">{page.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    </div>
  </section>

  <section class="mt-14" aria-label="Why iDuckImg">
    <ul class="grid gap-4 sm:grid-cols-3">
      {
        why.map((item) => (
          <li class="card p-4">
            <span aria-hidden="true" class="text-[28px] leading-none">
              {item.emoji}
            </span>
            <h3 class="mt-2 text-lg font-black">{item.title}</h3>
            <p class="mt-1 text-sm text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14" aria-label="How-to guides">
    <h2 class="text-3xl font-black tracking-tight">How-to guides</h2>
    <p class="mt-1 text-muted">Short walkthroughs for the jobs people search for most. Each gives the answer first.</p>
    <ul class="card-grid mt-3">
      {
        GUIDES.slice(0, 6).map((g) => (
          <li>
            <a href={guidePath(g.slug)} class="card card-link h-full p-4">
              <span class="block text-[17px] font-black">{g.title}</span>
              <span class="mt-1 block text-sm leading-[19px] text-muted">{g.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-3"><a class="link" href="/guides/">All {GUIDES.length} how-to guides</a></p>
  </section>

  <section class="mt-14" aria-label="Common questions">
    <h2 class="text-3xl font-black tracking-tight">Common questions</h2>
    <div class="mt-4 grid gap-3">
      {
        faqs.map((f) => (
          <details class="card px-4 py-3">
            <summary class="cursor-pointer text-lg font-black">{f.q}</summary>
            <p class="mt-2 leading-relaxed">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <script>
    // The big search box is a button for the Ctrl K window, which lives in the page shell.
    document.querySelectorAll('[data-open-palette]').forEach((el) =>
      el.addEventListener('click', () => document.getElementById('search-open')?.click()),
    );

    // Group chips narrow the list of tools; "Everything" shows all of them again.
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const wanted = chip.dataset['filter'] ?? 'all';
        chips.forEach((c) => c.setAttribute('aria-checked', String(c === chip)));
        document.querySelectorAll<HTMLElement>('[data-card-group]').forEach((g) => {
          g.hidden = wanted !== 'all' && g.dataset['group'] !== wanted;
        });
      }),
    );
  </script>
</AppShell>
