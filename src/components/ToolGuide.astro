---
/** The written guide under a tool: numbered steps and short notes. The questions are drawn by ToolLayout, last on the page. */
interface Props {
  title: string;
  steps: string[];
  notes?: string[];
}
const { title, steps, notes = [] } = Astro.props;
---

<section class="prose">
  <h2>{title}</h2>
  <ol>
    {steps.map((step) => <li>{step}</li>)}
  </ol>
  {notes.map((note) => <p class="mt-3 text-sm">{note}</p>)}
</section>
