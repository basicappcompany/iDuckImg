---
import AppShell from './AppShell.astro';
import AdSlot from './AdSlot.astro';
import { groupMates, toolForPath, toolPath } from '../lib/tools';
import { breadcrumbLd, faqLd, howToLd, webApplicationLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  heading: string;
  /** Show the "files never leave your device" message. Only for tools where it is true. */
  clientSide?: boolean;
  /** False for calculators that take no file: the "files never leave your device" line is then left out. */
  usesFiles?: boolean;
  /**
   * For landing pages ("heic to jpg"), which are not in the tool list: the details a tool page
   * would get from src/lib/tools.ts, plus the parent tool for "More in" and the breadcrumb.
   */
  landing?: { emoji: string; summary: string; quick: string; parentSlug: string };
  steps?: string[];
  faqs?: { q: string; a: string }[];
}
const { title, description, heading, clientSide = true, usesFiles = true, landing, steps = [], faqs = [] } = Astro.props;
const own = toolForPath(Astro.url.pathname);
const tool = own ?? (landing ? toolForPath(toolPath(landing.parentSlug)) : undefined);
const info = own ?? landing;
const mates = tool ? (own ? groupMates(tool) : [tool, ...groupMates(tool)]) : [];
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const trail = [{ name: 'Home', path: '/' }, ...(tool ? [{ name: tool.group, path: '/image-tools/' }] : []), { name: heading, path }];
const jsonLd = [
  webApplicationLd(heading, path, description),
  breadcrumbLd(trail),
  ...(steps.length ? [howToLd(heading, steps)] : []),
  ...(faqs.length ? [faqLd(faqs)] : []),
];
---

<AppShell title={title} description={description} jsonLd={jsonLd}>
  {
    tool && (
      <p class="eyebrow">
        <a href="/" class="underline decoration-2 underline-offset-2">Home</a>
        <span aria-hidden="true"> / </span>
        {tool.group}
      </p>
    )
  }
  <h1 class="display mt-2 flex items-center gap-3 text-4xl sm:text-5xl">
    {info && <span aria-hidden="true" class="text-4xl sm:text-5xl">{info.emoji}</span>}
    <span>{heading}</span>
  </h1>
  {info && <p class="mt-3 text-lg text-muted">{info.summary}</p>}

  <div class="mt-3 flex flex-wrap gap-2">
    {clientSide && <span class="pill pill-ok">Runs in your browser</span>}
    <span class="pill">No sign-up</span>
    <span class="pill">No watermark</span>
  </div>
  {clientSide && usesFiles && <p class="mt-3 text-sm font-bold">Your files never leave your device.</p>}

  {
    info && (
      <section aria-label="Quick answer" class="card mt-5 p-4">
        <p class="eyebrow">Quick answer</p>
        <p class="mt-1 leading-relaxed">{info.quick}</p>
      </section>
    )
  }

  <section class="mt-5 grid gap-5" aria-label="Tool">
    <slot />
  </section>

  <AdSlot name="below-tool" width={728} height={90} />

  <div class="mt-12">
    <slot name="content" />
  </div>

  {
    tool && mates.length > 0 && (
      <nav class="mt-12" aria-label={`More in ${tool.group}`}>
        <h2 class="text-2xl font-black tracking-tight">More in "{tool.group}"</h2>
        <ul class="mt-3 grid gap-4 sm:grid-cols-2">
          {mates.map((mate) => (
            <li>
              <a href={toolPath(mate.slug)} class="card card-link h-full p-4">
                <span class="flex items-center gap-2 text-lg font-black">
                  <span aria-hidden="true">{mate.emoji}</span>
                  {mate.name}
                </span>
                <span class="mt-1 block text-sm text-muted">{mate.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</AppShell>
