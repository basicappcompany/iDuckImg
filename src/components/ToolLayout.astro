---
import AppShell from './AppShell.astro';
import AdSlot from './AdSlot.astro';
import { groupMates, toolForPath, toolPath } from '../lib/tools';
import { breadcrumbLd, faqLd, howToLd, webApplicationLd } from '../lib/seo';
import { guideForTool, guidePath } from '../lib/guides';
import { alternatesFor, dictFor, format, localePath, splitLocalePath, toolText } from '../i18n';

interface Props {
  title: string;
  description: string;
  heading: string;
  /** Show the "files never leave your device" message. Only for tools where it is true. */
  clientSide?: boolean;
  /** False for calculators that take no file: the "files never leave your device" line is then left out. */
  usesFiles?: boolean;
  /**
   * For landing pages ("heic to jpg"), which are not in the tool list: the details a tool page
   * would get from src/lib/tools.ts, plus the parent tool for "More in" and the breadcrumb.
   */
  landing?: { emoji: string; summary: string; quick: string; parentSlug: string };
  steps?: string[];
  faqs?: { q: string; a: string }[];
  /** The language of the page. Translated tool pages live at /es/compress-image/ and so on. */
  locale?: string;
}
const { title, description, heading, clientSide = true, usesFiles = true, landing, steps = [], faqs = [], locale = 'en' } = Astro.props;
const isEn = locale === 'en';
const d = dictFor(locale);
const lp = (p: string) => localePath(locale, p);
const basePath = splitLocalePath(Astro.url.pathname).rest;
const alternates = alternatesFor(basePath);
const own = toolForPath(basePath);
const tool = own ?? (landing ? toolForPath(toolPath(landing.parentSlug)) : undefined);
const info = own ? { ...own, ...toolText(locale, own.slug) } : landing;
const guide = tool ? guideForTool(tool.slug) : undefined;
const mates = tool ? (own ? groupMates(tool) : [tool, ...groupMates(tool)]) : [];
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const trail = [
  { name: d.breadcrumbHome, path: lp('/') },
  ...(tool ? [{ name: d.groups[tool.group], path: isEn ? '/image-tools/' : lp('/') }] : []),
  { name: heading, path },
];
const jsonLd = [
  webApplicationLd(heading, path, description, locale),
  breadcrumbLd(trail),
  ...(steps.length ? [howToLd(heading, steps)] : []),
  ...(faqs.length ? [faqLd(faqs)] : []),
];
---

<AppShell title={title} description={description} jsonLd={jsonLd} locale={locale} alternates={alternates}>
  {
    tool && (
      <p class="eyebrow">
        <a href={lp('/')} class="underline decoration-2 underline-offset-2">{d.breadcrumbHome}</a>
        <span aria-hidden="true"> / </span>
        {d.groups[tool.group]}
      </p>
    )
  }
  <h1 class="display mt-2 flex items-center gap-3 text-4xl sm:text-5xl">
    {info && <span aria-hidden="true" class="text-4xl sm:text-5xl">{info.emoji}</span>}
    <span>{heading}</span>
  </h1>
  {info && <p class="mt-3 text-lg text-muted">{info.summary}</p>}

  <div class="mt-3 flex flex-wrap gap-2">
    {clientSide && <span class="pill pill-ok">{d.runsInBrowser}</span>}
    <span class="pill">{d.noSignup}</span>
    <span class="pill">{d.noWatermark}</span>
  </div>
  {clientSide && usesFiles && <p class="mt-3 text-sm font-bold">{d.filesNeverLeave}</p>}

  {
    info && (
      <section aria-label="Quick answer" class="card mt-5 p-4">
        <p class="eyebrow">{d.quickAnswer}</p>
        <p class="mt-1 leading-relaxed">{info.quick}</p>
        {guide && (
          <p class="mt-2 text-sm">
            <span aria-hidden="true">📖</span> <a class="link" href={guidePath(guide.slug)}>{isEn ? 'Read the guide' : d.readGuide}: {guide.title}</a>
          </p>
        )}
      </section>
    )
  }

  {!isEn && <p class="mt-5 text-sm font-bold" data-controls-note>{d.controlsEnglish}</p>}

  <section class="mt-5 grid gap-5" aria-label="Tool">
    <slot />
  </section>

  <AdSlot name="below-tool" width={728} height={90} />

  <div class="mt-12">
    <slot name="content" />
  </div>

  {
    tool && mates.length > 0 && (
      <nav class="mt-12" aria-label={isEn ? `More in ${tool.group}` : format(d.moreIn, { group: d.groups[tool.group] })} data-more-nav>
        <h2 class="text-2xl font-black tracking-tight">{format(d.moreIn, { group: d.groups[tool.group] })}</h2>
        <ul class="mt-3 grid gap-4 sm:grid-cols-2">
          {mates.map((mate) => (
            <li>
              <a href={lp(toolPath(mate.slug))} class="card card-link h-full p-4">
                <span class="flex items-center gap-2 text-lg font-black">
                  <span aria-hidden="true">{mate.emoji}</span>
                  {toolText(locale, mate.slug).name}
                </span>
                <span class="mt-1 block text-sm text-muted">{toolText(locale, mate.slug).summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</AppShell>
