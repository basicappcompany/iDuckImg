---
import '../styles/global.css';
import DuckMark from './DuckMark.astro';
import CommandPalette from './CommandPalette.astro';
import { TOOL_GROUPS, toolForPath, toolPath, toolsInGroup } from '../lib/tools';
import { PLAN_CATEGORIES } from '../lib/tool-plan';
import { quickGroups } from '../lib/quick';
import { LANDING_PAGES, landingPath } from '../lib/landing';
import { THEME_STORAGE_KEY } from '../lib/theme';
import { COMMUNITY, communityPath } from '../lib/community';
import { OG_IMAGE, SITE_NAME, serialize } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** For pages that must stay out of search results, such as the 404 page. */
  noindex?: boolean;
  /** Structured data objects (schema.org), written as JSON-LD in the head. */
  jsonLd?: unknown[];
}
const { title, description, noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isHome = path === '/';
const groupIcon = (group: string) => PLAN_CATEGORIES.find((c) => c.id === group)?.emoji ?? '🧰';
// The group holding the current page starts open, like iDuckPDF's sidebar; otherwise the first one does.
// The Tools group holding the current page starts open (the first one otherwise). The same goes for
// the Quick tools sub-category.
const quick = quickGroups();
const openQuick = quick.find((g) => g.items.some((i) => i.href === path))?.id ?? quick[0]?.id;
const openGroup = toolForPath(path)?.group ?? TOOL_GROUPS[0];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="iDuckImg: free online image tools with a duck mascot" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    {jsonLd.map((item) => <script type="application/ld+json" set:html={serialize(item)} />)}
    <!-- Runs before first paint, so a visitor who chose dark mode never sees a flash of light. -->
    <script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
      try {
        const saved = localStorage.getItem(key);
        if (saved === 'dark' || saved === 'light') document.documentElement.setAttribute('data-theme', saved);
      } catch {
        // Storage can be blocked (private mode); the system setting then applies.
      }
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:border-2 focus:border-line focus:bg-duck focus:px-4 focus:py-2 focus:font-black focus:text-duckink"
    >
      Skip to the tool
    </a>

    <div class="shell">
      <aside class="sidebar" id="sidebar" aria-label="Site menu">
        <div class="nav-scroll">
          <a href="/" class="nav-brand" aria-label="iDuckImg home">
            <DuckMark size={34} />
            <span>iDuckImg</span>
          </a>

          <button type="button" id="sidebar-search" class="nav-search" aria-label="Search tools, pages and actions">
            <span aria-hidden="true">🔍</span>
            <span class="flex-1 text-left">Search…</span>
            <kbd aria-hidden="true">Ctrl K</kbd>
          </button>

          <nav aria-label="Main">
            <a class="nav-item" href="/" aria-current={isHome ? 'page' : undefined}>
              <span class="nav-icon" aria-hidden="true">🏠</span><span class="nav-text">Home</span>
            </a>
            <a class="nav-item" href="/chat/" aria-current={path === '/chat/' ? 'page' : undefined}>
              <span class="nav-icon" aria-hidden="true">💬</span><span class="nav-text">Ask the helper</span>
            </a>
            <a class="nav-item" href="/image-tools/" aria-current={path === '/image-tools/' ? 'page' : undefined}>
              <span class="nav-icon" aria-hidden="true">🧰</span><span class="nav-text">All image tools</span>
            </a>

          </nav>

          <nav aria-label="Quick tools">
            <button
              type="button"
              class="nav-label nav-label-btn"
              data-nav-group
              aria-expanded="true"
              aria-controls="quick-body"
            >
              <span>⚡ Quick tools</span>
              <span class="nav-chevron" aria-hidden="true">›</span>
            </button>
            <div id="quick-body" class="grid gap-px" style="grid-template-columns: minmax(0, 1fr)">
              {
                quick.map((group) => {
                  const open = group.id === openQuick;
                  return (
                    <div>
                      <button
                        type="button"
                        class="nav-group"
                        data-nav-group
                        aria-expanded={open ? 'true' : 'false'}
                        aria-controls={`quick-${group.id}`}
                      >
                        <span class="nav-icon" aria-hidden="true">{group.emoji}</span>
                        <span class="nav-text">{group.name}</span>
                        <span class="nav-chevron" aria-hidden="true">›</span>
                      </button>
                      <ul class="nav-children" id={`quick-${group.id}`} hidden={!open}>
                        {group.items.map((q) => (
                          <li>
                            <a class="nav-item nav-small" href={q.href} aria-current={path === q.href ? 'page' : undefined}>
                              <span class="nav-icon" aria-hidden="true">{q.emoji}</span>
                              <span class="nav-text">{q.name}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  );
                })
              }
            </div>
          </nav>

          <nav aria-label="Tools">
            <p class="nav-label">Tools</p>
            {
              TOOL_GROUPS.map((group, i) => {
                const open = group === openGroup;
                return (
                  <div data-group>
                    <button
                      type="button"
                      class="nav-group"
                      data-nav-group
                      aria-expanded={open ? 'true' : 'false'}
                      aria-controls={`group-${i}`}
                    >
                      <span class="nav-icon" aria-hidden="true">{groupIcon(group)}</span>
                      <span class="nav-text">{group}</span>
                      <span class="nav-chevron" aria-hidden="true">›</span>
                    </button>
                    <ul class="nav-children" id={`group-${i}`} hidden={!open}>
                      {toolsInGroup(group).map((tool) => (
                        <li data-tool={tool.slug}>
                          <a
                            class="nav-item nav-small"
                            href={toolPath(tool.slug)}
                            aria-current={path === toolPath(tool.slug) ? 'page' : undefined}
                          >
                            <span class="nav-icon" aria-hidden="true">{tool.emoji}</span>
                            <span class="nav-text">{tool.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                );
              })
            }
          </nav>

          <p class="nav-label">Community</p>
          <ul>
            {
              COMMUNITY.map((page) => (
                <li>
                  <a
                    class="nav-item"
                    href={communityPath(page.slug)}
                    aria-current={path === communityPath(page.slug) ? 'page' : undefined}
                  >
                    <span class="nav-icon" aria-hidden="true">{page.emoji}</span>
                    <span class="nav-text">{page.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>

          <p class="nav-label">Also from iDuck</p>
          <a class="nav-item" href="https://iduckpdf.com/" rel="noopener">
            <span class="nav-icon" aria-hidden="true">📚</span><span class="nav-text">iDuckPDF: PDF tools</span>
          </a>
        </div>
      </aside>

      <div class="scrim" data-menu-scrim></div>

      <div class="min-w-0">
        <header class="topbar sticky top-0 z-20 flex items-center gap-2 px-3 py-2">
          <button
            type="button"
            class="btn btn-sm"
            data-menu-button
            aria-label="Open the menu"
            aria-controls="sidebar"
            aria-expanded="false">☰</button
          >
          <a href="/" class="flex items-center gap-2 rounded-lg min-[900px]:hidden">
            <DuckMark size={28} />
            <span class="font-black">iDuckImg</span>
          </a>
          <div class="ml-auto flex items-center gap-2">
            <button type="button" class="btn btn-sm" id="search-open" aria-label="Open search">
              <span aria-hidden="true">🔍</span>
              <span class="hidden sm:inline">Search · Ctrl K</span>
            </button>
            <button
              type="button"
              class="btn btn-sm"
              id="theme-toggle"
              aria-label="Switch between light and dark mode"
              aria-pressed="false"
            >
              <span data-theme-icon="moon" aria-hidden="true">🌙</span>
              <span data-theme-icon="sun" aria-hidden="true">☀️</span>
            </button>
            <a href="/support/" class="btn btn-sm btn-primary" aria-label="Support iDuckImg">
              <span aria-hidden="true">💛</span>
              <span class="hidden min-[520px]:inline">Support</span>
            </a>
          </div>
        </header>

        <main id="main" class="mx-auto w-full max-w-4xl px-4 py-8">
          <slot />
        </main>

        <footer class="mx-auto max-w-4xl px-4 pb-10 text-sm text-muted">
          <nav aria-label="Popular conversions" class="border-t-2 border-line pt-6">
            <p class="eyebrow mb-2">Popular</p>
            <ul class="flex flex-wrap gap-x-4 gap-y-1">
              {
                LANDING_PAGES.map((p) => (
                  <li>
                    <a class="link" href={landingPath(p.slug)}>
                      {p.h1.replace(' converter', '')}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <p class="mt-5">
            iDuckImg: free image tools that run in your browser. Also try{" "}
            <a class="link" href="https://iduckpdf.com/" rel="noopener">iDuckPDF</a>.
          </p>
          <p class="mt-2 flex flex-wrap gap-x-4">
            <a class="link" href="/image-tools/">All image tools</a>
            <a class="link" href="/about/">About</a>
            <a class="link" href="/privacy/">Privacy</a>
            <a class="link" href="/terms/">Terms</a>
            <a class="link" href="/feedback/">Feedback</a>
          </p>
        </footer>
      </div>
    </div>

    <CommandPalette />

    <script>
      import { THEME_STORAGE_KEY } from '../lib/theme';

      const root = document.documentElement;
      const body = document.body;

      // ---- light / dark ----
      const toggle = document.getElementById('theme-toggle');
      const isDark = () =>
        root.getAttribute('data-theme') === 'dark' ||
        (root.getAttribute('data-theme') !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
      const syncToggle = () => toggle?.setAttribute('aria-pressed', String(isDark()));
      syncToggle();
      window.addEventListener('duck-theme', syncToggle);
      toggle?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem(THEME_STORAGE_KEY, next);
        } catch {
          // Private mode: the choice still applies for this visit.
        }
        syncToggle();
      });

      // ---- phone menu ----
      const menuButton = document.querySelector<HTMLElement>('[data-menu-button]');
      const setMenu = (open: boolean) => {
        body.dataset['menu'] = open ? 'open' : 'closed';
        menuButton?.setAttribute('aria-expanded', String(open));
      };
      menuButton?.addEventListener('click', () => setMenu(body.dataset['menu'] !== 'open'));
      document.querySelector('[data-menu-scrim]')?.addEventListener('click', () => setMenu(false));
      document.querySelectorAll('#sidebar a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      window.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') setMenu(false);
      });

      // ---- collapsible tool groups ----
      document.querySelectorAll<HTMLButtonElement>('[data-nav-group]').forEach((button) => {
        button.addEventListener('click', () => {
          const open = button.getAttribute('aria-expanded') !== 'true';
          button.setAttribute('aria-expanded', String(open));
          const list = document.getElementById(button.getAttribute('aria-controls') ?? '');
          if (list) list.hidden = !open;
        });
      });

      // ---- search: the Ctrl K window lives in CommandPalette.astro ----
      document.getElementById('sidebar-search')?.addEventListener('click', () => {
        setMenu(false);
        document.getElementById('search-open')?.click();
      });
    </script>
  </body>
</html>
